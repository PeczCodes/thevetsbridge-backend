model UserBalance {
  id               String   @id @default(cuid())
  userId           String   @unique
  availableBalance Decimal  @default(0.0) @db.Decimal(12, 2)
  reservedBalance  Decimal  @default(0.0) @db.Decimal(12, 2)
  totalEarned      Decimal  @default(0.0) @db.Decimal(12, 2)
  totalWithdrawn   Decimal  @default(0.0) @db.Decimal(12, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WorkerPayoutAccount {
  id                    String                 @id @default(cuid())
  workerId              String
  bankCode              String
  bankName              String
  accountNumber         String
  accountName           String
  providerRecipientCode String
  isVerified            Boolean                @default(true)
  isDefault             Boolean                @default(false)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  user                  User                   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  financialTransactions FinancialTransaction[]

  @@unique([workerId, bankCode, accountNumber])
}

model FinancialTransaction {
  id                   String                 @id @default(cuid())
  userId               String
  payoutAccountId      String?
  amount               Decimal                @db.Decimal(12, 2)
  type                 FinancialTxType
  status               FinancialTxStatus      @default(PENDING)
  reference            String                 @unique
  providerRef          String?                @unique
  providerTransferCode String?
  failureReason        String?
  metadata             Json?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  user                 User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  payoutAccount        WorkerPayoutAccount?   @relation(fields: [payoutAccountId], references: [id])
  statusHistory        FinancialTxStatusLog[]

  @@index([userId])
}

model FinancialTxStatusLog {
  id          String               @id @default(cuid())
  txId        String
  fromStatus  FinancialTxStatus?
  toStatus    FinancialTxStatus
  reason      String?
  createdAt   DateTime             @default(now())
  transaction FinancialTransaction @relation(fields: [txId], references: [id], onDelete: Cascade)

  @@index([txId])
}

enum FinancialTxType {
  WITHDRAWAL
  ESCROW_RELEASE
  REFUND
  PLATFORM_COMMISSION
  ADJUSTMENT
  BONUS
}

enum FinancialTxStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model ConsultationSession {
  id             String       @id @default(cuid())
  consultationId String       @unique
  provider       String       // "LIVEKIT", "DAILY", etc.
  roomId         String
  meetingId      String
  sessionToken   String?
  startedAt      DateTime?
  endedAt        DateTime?
  metadata       Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
}

model ConsultationPresence {
  id              String       @id @default(cuid())
  consultationId  String
  userId          String
  role            String       // "VET" or "CUSTOMER"
  joinedAt        DateTime     @default(now())
  leftAt          DateTime?
  lastHeartbeatAt DateTime     @default(now())
  online          Boolean      @default(true)
  consultation    Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  @@index([consultationId])
  @@index([userId])
}

model ConsultationDispute {
  id             String        @id @default(cuid())
  consultationId String        @unique
  raisedById     String
  reason         String
  details        String?
  status         DisputeStatus @default(OPEN)
  resolvedAt     DateTime?
  resolvedById   String?
  resolution     String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  consultation   Consultation  @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  raisedBy       User          @relation("DisputesRaised", fields: [raisedById], references: [id])
  resolvedBy     User?         @relation("DisputesResolved", fields: [resolvedById], references: [id])
}
