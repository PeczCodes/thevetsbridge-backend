generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String                 @id @default(cuid())
  email                 String                 @unique
  phone                 String?                @unique
  passwordHash          String?
  firstName             String
  lastName              String
  displayName           String?
  avatarMediaId         String?                @unique
  isAdmin               Boolean                @default(false)
  isActive              Boolean                @default(true)
  failedLoginAttempts   Int                    @default(0)
  lockoutUntil          DateTime?
  timezone              String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  addresses             Address[]
  animalsOwned          AnimalOwnership[]
  appointments          Appointment[]
  auditLogs             AuditLog[]
  carts                 Cart[]
  chatMessages          ChatMessage[]
  customerConsultations Consultation[]         @relation("CustomerConsultations")
  directChannels        DirectChannel[]        @relation("CustomerDirectChannels")
  notifications         Notification[]
  orders                Order[]
  ownedOrganizations    Organization[]
  organizations         OrganizationMember[]
  payments              Payment[]
  productReviewsGiven   ProductReview[]
  sessions              Session[]
  payoutAccounts        WorkerPayoutAccount[]
  financialTransactions FinancialTransaction[]
  disputesRaised        ConsultationDispute[]  @relation("DisputesRaised")
  disputesResolved      ConsultationDispute[]  @relation("DisputesResolved")
  balance               UserBalance?
  avatarMedia           Media?                 @relation("UserAvatar", fields: [avatarMediaId], references: [id])
  vendorProfile         VendorProfile?
  vendorReviewsGiven    VendorReview[]
  vetProfile            VetProfile?
  vetReviewsGiven       VetReview[]
  passwordResetTokens   PasswordResetToken[]
}

model Session {
  id               String   @id @default(cuid())
  userId           String
  refreshTokenHash String
  userAgent        String?
  ipAddress        String?
  isRevoked        Boolean  @default(false)
  expiresAt        DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model VetProfile {
  id                     String              @id @default(cuid())
  userId                 String              @unique
  specializations        VetSpecialization[] @default([GENERAL_PRACTICE])
  licenseNumber          String?             @unique
  licenseCountry         String?
  licenseDocMediaId      String?             @unique
  experience             Int?
  qualifications         String[]
  languages              String[]
  avatarMediaId          String?             @unique
  consultationFee        Decimal?            @db.Decimal(10, 2)
  emergencyFee           Decimal?            @db.Decimal(10, 2)
  bio                    String?
  certificates           Json?
  status                 ApplicationStatus   @default(PENDING)
  rejectionReason        String?
  isAvailable            Boolean             @default(true)
  isActive               Boolean             @default(true)
  rating                 Float               @default(5.0)
  totalConsults          Int                 @default(0)
  directMessagingEnabled Boolean             @default(false)
  directMessagingPrice   Decimal             @default(0.00)
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  slug                   String?             @unique
  clinicAddressId        String?
  appointments           Appointment[]
  consultations          Consultation[]      @relation("VetConsultations")
  directChannels         DirectChannel[]     @relation("VetDirectChannels")
  medicalRecords         MedicalRecord[]
  prescriptions          Prescription[]
  vaccinations           Vaccination[]
  availability           VetAvailability[]
  avatarMedia            Media?              @relation("VetAvatar", fields: [avatarMediaId], references: [id])
  clinicAddress          Address?            @relation("VetClinicAddress", fields: [clinicAddressId], references: [id])
  licenseDocMedia        Media?              @relation("VetLicense", fields: [licenseDocMediaId], references: [id])
  user                   User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviews                VetReview[]
  slots                  VetSlot[]
  timeOff                VetTimeOff[]

  @@index([status, isAvailable])
  @@index([rating])
  @@index([specializations])
}

model VendorProfile {
  id              String                 @id @default(cuid())
  userId          String                 @unique
  businessName    String?
  businessPhone   String?
  businessAddress String?
  avatarMediaId   String?                @unique
  status          ApplicationStatus      @default(PENDING)
  rejectionReason String?
  isActive        Boolean                @default(true)
  rating          Float                  @default(5.0)
  totalSales      Int                    @default(0)
  bio             String?
  slug            String?                @unique
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  products        VendorProduct[]
  avatarMedia     Media?                 @relation("VendorAvatar", fields: [avatarMediaId], references: [id])
  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviews         VendorReview[]
  shippingProfile VendorShippingProfile?
  shipments       Shipment[]

  @@index([status, rating])
}

model VendorShippingProfile {
  id                    String           @id @default(cuid())
  vendorId              String           @unique
  shippingStrategy      ShippingStrategy @default(FLAT_RATE)
  baseShippingFee       Decimal          @default(0.0) @db.Decimal(12, 2)
  additionalItemFee     Decimal          @default(0.0) @db.Decimal(12, 2)
  freeShippingThreshold Decimal?         @db.Decimal(12, 2)
  supportsPickup        Boolean          @default(false)
  estimatedDeliveryDays Int              @default(3)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  vendor                VendorProfile    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
}

model VetAvailability {
  id        String     @id @default(cuid())
  vetId     String
  dayOfWeek Int
  startTime String
  endTime   String
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  vet       VetProfile @relation(fields: [vetId], references: [id], onDelete: Cascade)

  @@index([vetId])
}

model VetTimeOff {
  id        String     @id @default(cuid())
  vetId     String
  startDate DateTime
  endDate   DateTime
  reason    String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  vet       VetProfile @relation(fields: [vetId], references: [id], onDelete: Cascade)

  @@index([vetId])
}

model Address {
  id             String       @id @default(cuid())
  userId         String
  label          String?
  country        String
  state          String
  city           String
  street1        String
  street2        String?
  postalCode     String?
  latitude       Float?
  longitude      Float?
  isDefault      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders         Order[]
  vetsWithClinic VetProfile[] @relation("VetClinicAddress")

  @@index([userId])
}

model Organization {
  id        String               @id @default(cuid())
  name      String
  type      OrganizationType
  ownerId   String
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  animals   Animal[]
  owner     User                 @relation(fields: [ownerId], references: [id])
  members   OrganizationMember[]
}

model OrganizationMember {
  id             String           @id @default(cuid())
  userId         String
  organizationId String
  role           OrganizationRole
  createdAt      DateTime         @default(now())
  organization   Organization     @relation(fields: [organizationId], references: [id])
  user           User             @relation(fields: [userId], references: [id])

  @@unique([userId, organizationId])
}

model Animal {
  id                 String            @id @default(cuid())
  name               String?
  type               AnimalType
  species            String?
  breed              String?
  photoMediaId       String?           @unique
  status             AnimalStatus      @default(ACTIVE)
  organizationId     String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  sex                AnimalSex         @default(UNKNOWN)
  color              String?
  birthDate          DateTime?
  estimatedAgeMonths Int?
  ageType            AnimalAgeType?
  healthStatus       HealthStatus      @default(HEALTHY)
  microchipId        String?           @unique
  slug               String?           @unique
  weight             Float?
  medicalNotes       String?
  organization       Organization?     @relation(fields: [organizationId], references: [id])
  photoMedia         Media?            @relation("AnimalPhoto", fields: [photoMediaId], references: [id])
  healthLogs         AnimalHealthLog[]
  ownerships         AnimalOwnership[]
  appointments       Appointment[]
  consultations      Consultation[]
  medicalRecords     MedicalRecord[]
  prescriptions      Prescription[]
  vaccinations       Vaccination[]

  @@index([organizationId])
  @@index([status])
}

model AnimalOwnership {
  id        String          @id @default(cuid())
  animalId  String
  userId    String
  isActive  Boolean         @default(true)
  status    OwnershipStatus
  startDate DateTime        @default(now())
  endDate   DateTime?
  animal    Animal          @relation(fields: [animalId], references: [id])
  user      User            @relation(fields: [userId], references: [id])

  @@index([animalId])
  @@index([userId])
  @@index([animalId, endDate])
}

model AnimalHealthLog {
  id          String   @id @default(cuid())
  animalId    String
  weight      Float?
  temperature Float?
  heartRate   Int?
  notes       String?
  recordedAt  DateTime @default(now())
  recordedBy  String?
  animal      Animal   @relation(fields: [animalId], references: [id], onDelete: Cascade)

  @@index([animalId, recordedAt])
}

model VetSlot {
  id          String        @id @default(cuid())
  vetId       String
  startsAt    DateTime
  endsAt      DateTime
  status      VetSlotStatus @default(AVAILABLE)
  createdAt   DateTime      @default(now())
  appointment Appointment?
  vet         VetProfile    @relation(fields: [vetId], references: [id], onDelete: Cascade)

  @@unique([vetId, startsAt])
  @@index([vetId, status, startsAt])
}

model Appointment {
  id                 String            @id @default(cuid())
  animalId           String
  ownerId            String
  vetId              String
  slotId             String?           @unique
  type               AppointmentType
  status             AppointmentStatus @default(PENDING)
  scheduledStart     DateTime
  scheduledEnd       DateTime
  notes              String?
  videoSessionId     String?
  cancellationReason String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  deletedAt          DateTime?
  animal             Animal            @relation(fields: [animalId], references: [id])
  owner              User              @relation(fields: [ownerId], references: [id])
  slot               VetSlot?          @relation(fields: [slotId], references: [id])
  vet                VetProfile        @relation(fields: [vetId], references: [id])
  consultation       Consultation?
  payment            Payment?

  @@index([vetId, scheduledStart])
  @@index([ownerId])
  @@index([animalId])
  @@index([status])
}

model Consultation {
  id                      String              @id @default(cuid())
  animalId                String
  vetId                   String
  customerId              String
  mode                    ConsultationMode
  status                  ConsultationStatus  @default(SCHEDULED)
  scheduledAt             DateTime?
  startedAt               DateTime?
  endedAt                 DateTime?
  followUpExpiresAt       DateTime?
  notes                   String?
  reason                  String?
  symptoms                String?
  files                   Json?
  vetJoinedAt             DateTime?
  customerJoinedAt        DateTime?
  summarySubmittedAt      DateTime?
  disputeWindowExpiresAt  DateTime?
  cancellationReason      CancellationReason?
  createdAt               DateTime            @default(now())
  appointmentId           String?             @unique
  chatMessages            ChatMessage[]
  animal                  Animal              @relation(fields: [animalId], references: [id])
  appointment             Appointment?        @relation(fields: [appointmentId], references: [id])
  customer                User                @relation("CustomerConsultations", fields: [customerId], references: [id])
  vet                     VetProfile          @relation("VetConsultations", fields: [vetId], references: [id])
  prescriptions           Prescription[]
  session                 ConsultationSession?
  dispute                 ConsultationDispute?
  medicalRecord           MedicalRecord?
  presences               ConsultationPresence[]

  @@index([scheduledAt])
  @@index([customerId])
  @@index([vetId])
  @@index([status])
}

model MedicalRecord {
  id              String      @id @default(cuid())
  animalId        String
  recordedByVetId String?
  title           String
  diagnosis       String?
  treatment       String?
  notes           String?
  attachments     Json?
  consultationId  String?     @unique
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  animal          Animal      @relation(fields: [animalId], references: [id], onDelete: Cascade)
  recordedByVet   VetProfile? @relation(fields: [recordedByVetId], references: [id])
  consultation    Consultation? @relation(fields: [consultationId], references: [id], onDelete: SetNull)

  @@index([animalId])
  @@index([recordedByVetId])
}

model Vaccination {
  id                  String      @id @default(cuid())
  animalId            String
  administeredByVetId String?
  vaccineName         String
  batchNumber         String?
  administeredAt      DateTime
  nextDueAt           DateTime?
  notes               String?
  createdAt           DateTime    @default(now())
  administeredByVet   VetProfile? @relation(fields: [administeredByVetId], references: [id])
  animal              Animal      @relation(fields: [animalId], references: [id], onDelete: Cascade)

  @@index([animalId])
  @@index([nextDueAt])
}

model Prescription {
  id             String             @id @default(cuid())
  consultationId String
  animalId       String
  vetId          String
  status         PrescriptionStatus @default(ISSUED)
  issuedAt       DateTime           @default(now())
  expiresAt      DateTime?
  animal         Animal             @relation(fields: [animalId], references: [id])
  consultation   Consultation       @relation(fields: [consultationId], references: [id])
  vet            VetProfile         @relation(fields: [vetId], references: [id])
  items          PrescriptionItem[]

  @@index([animalId])
  @@index([vetId])
  @@index([consultationId])
}

model PrescriptionItem {
  id             String       @id @default(cuid())
  prescriptionId String
  productId      String?
  name           String
  dosage         String
  instructions   String?
  prescription   Prescription @relation(fields: [prescriptionId], references: [id])
  product        Product?     @relation(fields: [productId], references: [id])

  @@index([productId])
}

model Product {
  id                   String             @id @default(cuid())
  name                 String
  description          String?
  requiresPrescription Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  prescriptionItems    PrescriptionItem[]
  reviews              ProductReview[]
  vendorListings       VendorProduct[]
}

model VendorProduct {
  id             String        @id @default(cuid())
  vendorId       String
  productId      String
  price          Decimal
  stock          Int
  version        Int           @default(0)
  sku            String?       @unique
  slug           String?       @unique
  compareAtPrice Decimal?      @db.Decimal(12, 2)
  weight         Float?
  attributes     Json?
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  cartItems      CartItem[]
  orderItems     OrderItem[]
  product        Product       @relation(fields: [productId], references: [id])
  vendor         VendorProfile @relation(fields: [vendorId], references: [id])

  @@unique([vendorId, productId])
  @@index([productId])
}

model Coupon {
  id             String       @id @default(cuid())
  code           String       @unique
  description    String?
  discountType   DiscountType
  discountValue  Decimal      @db.Decimal(12, 2)
  minOrderAmount Decimal?     @db.Decimal(12, 2)
  maxUses        Int?
  usedCount      Int          @default(0)
  vendorId       String?
  categoryId     String?
  startsAt       DateTime?
  expiresAt      DateTime?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  orders         Order[]

  @@index([isActive, expiresAt])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String
  status    CartStatus @default(ACTIVE)
  currency  String     @default("NGN")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]

  @@unique([userId, status], name: "one_active_cart_per_user", map: "cart_user_active_unique")
}

model CartItem {
  id              String        @id @default(cuid())
  cartId          String
  vendorProductId String
  quantity        Int           @default(1)
  unitPrice       Decimal       @db.Decimal(12, 2)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  cart            Cart          @relation(fields: [cartId], references: [id], onDelete: Cascade)
  vendorProduct   VendorProduct @relation(fields: [vendorProductId], references: [id])

  @@unique([cartId, vendorProductId])
}

model Order {
  id                String      @id @default(cuid())
  userId            String
  status            OrderStatus @default(PENDING)
  totalAmount       Decimal
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  shippingAddressId String?
  subtotal          Decimal     @default(0.0) @db.Decimal(12, 2)
  shippingCost      Decimal     @default(0.0) @db.Decimal(12, 2)
  discountAmount    Decimal?    @default(0) @db.Decimal(12, 2)
  taxAmount         Decimal?    @default(0) @db.Decimal(12, 2)
  couponId          String?
  couponCode        String?
  notes             String?
  coupon            Coupon?     @relation(fields: [couponId], references: [id])
  shippingAddress   Address?    @relation(fields: [shippingAddressId], references: [id])
  user              User        @relation(fields: [userId], references: [id])
  items             OrderItem[]
  payments          Payment?
  shipments         Shipment[]

  @@index([userId])
  @@index([status])
}

model OrderItem {
  id              String        @id @default(cuid())
  orderId         String
  vendorProductId String
  quantity        Int
  unitPrice       Decimal
  totalPrice      Decimal       @default(0.0) @db.Decimal(12, 2)
  productName     String?
  variantName     String?
  variantSku      String?
  createdAt       DateTime      @default(now())
  shipmentId      String?
  order           Order         @relation(fields: [orderId], references: [id])
  vendorProduct   VendorProduct @relation(fields: [vendorProductId], references: [id])
  shipment        Shipment?     @relation(fields: [shipmentId], references: [id], onDelete: SetNull)

  @@index([vendorProductId])
  @@index([shipmentId])
}

model Shipment {
  id                    String          @id @default(cuid())
  orderId               String
  vendorId              String
  status                ShipmentStatus  @default(PENDING)
  shippingFee           Decimal         @db.Decimal(12, 2)
  shippingMethod        ShippingMethod  @default(DELIVERY)
  estimatedDeliveryDays Int             @default(3)
  courierName           String?
  trackingNumber        String?
  trackingUrl           String?
  estimatedDelivery     DateTime?
  shippedAt             DateTime?
  deliveredAt           DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  order                 Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vendor                VendorProfile   @relation(fields: [vendorId], references: [id])
  items                 OrderItem[]
  events                ShipmentEvent[]

  @@unique([orderId, vendorId])
  @@index([vendorId])
}

model ShipmentEvent {
  id          String         @id @default(cuid())
  shipmentId  String
  status      ShipmentStatus
  description String?
  location    String?
  occurredAt  DateTime       @default(now())
  shipment    Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
}

model Payment {
  id               String          @id @default(cuid())
  userId           String
  purpose          PaymentPurpose
  orderId          String?         @unique
  appointmentId    String?         @unique
  amount           Decimal         @db.Decimal(12, 2)
  currency         String          @default("NGN")
  provider         PaymentProvider
  status           PaymentStatus   @default(PENDING)
  reference        String          @unique
  idempotencyKey   String?         @unique
  providerResponse Json?
  paidAt           DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  ledgerEntries    LedgerEntry[]
  appointment      Appointment?    @relation(fields: [appointmentId], references: [id])
  order            Order?          @relation(fields: [orderId], references: [id])
  user             User            @relation(fields: [userId], references: [id])
  refunds          PaymentRefund[]

  @@index([userId])
  @@index([status])
}

model PaymentRefund {
  id            String        @id @default(cuid())
  paymentId     String
  amount        Decimal       @db.Decimal(12, 2)
  reason        String?
  status        PaymentStatus @default(PENDING)
  reference     String        @unique
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  ledgerEntries LedgerEntry[]
  payment       Payment       @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
}

model LedgerEntry {
  id          String            @id @default(cuid())
  paymentId   String?
  refundId    String?
  accountType LedgerAccountType
  accountId   String
  amount      Decimal           @db.Decimal(12, 2)
  type        LedgerEntryType
  currency    String            @default("NGN")
  reference   String            @unique
  description String?
  createdAt   DateTime          @default(now())
  payment     Payment?          @relation(fields: [paymentId], references: [id])
  refund      PaymentRefund?    @relation(fields: [refundId], references: [id])

  @@index([accountId, accountType])
  @@index([paymentId])
  @@index([refundId])
  @@index([createdAt])
}

model WebhookEventLog {
  id           String             @id @default(cuid())
  provider     PaymentProvider
  eventId      String             @unique
  status       PaymentEventStatus @default(RECEIVED)
  payload      Json
  errorMessage String?
  createdAt    DateTime           @default(now())
  processedAt  DateTime?

  @@index([status])
}

model OutboxEvent {
  id          String    @id @default(cuid())
  type        String
  payload     Json
  published   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  publishedAt DateTime?

  @@index([published, createdAt])
  @@index([type])
}

model DirectChannel {
  id         String        @id @default(cuid())
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  customerId String
  vetId      String
  isActive   Boolean       @default(true)
  messages   ChatMessage[]
  customer   User          @relation("CustomerDirectChannels", fields: [customerId], references: [id])
  vet        VetProfile    @relation("VetDirectChannels", fields: [vetId], references: [id])

  @@unique([customerId, vetId])
  @@index([vetId])
}

model ChatMessage {
  id             String                  @id @default(cuid())
  senderId       String
  content        String?
  type           MessageType             @default(TEXT)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @default(now()) @updatedAt
  deletedAt      DateTime?
  readAt         DateTime?
  consultationId String?
  channelId      String?
  isFollowUp     Boolean                 @default(false)
  channel        DirectChannel?          @relation(fields: [channelId], references: [id])
  consultation   Consultation?           @relation(fields: [consultationId], references: [id])
  sender         User                    @relation(fields: [senderId], references: [id])
  attachments    ChatMessageAttachment[]

  @@index([consultationId, createdAt])
  @@index([channelId, createdAt])
  @@index([senderId])
}

model ChatMessageAttachment {
  id        String         @id @default(cuid())
  messageId String
  mediaId   String         @unique
  type      AttachmentType
  size      Int?
  createdAt DateTime       @default(now())
  media     Media          @relation("ChatMedia", fields: [mediaId], references: [id])
  message   ChatMessage    @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

model VetReview {
  id             String       @id @default(cuid())
  reviewerId     String
  vetId          String
  consultationId String       @unique
  rating         Int
  comment        String?
  status         ReviewStatus @default(PUBLISHED)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  isVerified     Boolean      @default(false)
  reviewer       User         @relation(fields: [reviewerId], references: [id])
  vet            VetProfile   @relation(fields: [vetId], references: [id])

  @@index([vetId])
  @@index([reviewerId])
}

model VendorReview {
  id         String        @id @default(cuid())
  reviewerId String
  vendorId   String
  orderId    String
  rating     Int
  comment    String?
  status     ReviewStatus  @default(PUBLISHED)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  reviewer   User          @relation(fields: [reviewerId], references: [id])
  vendor     VendorProfile @relation(fields: [vendorId], references: [id])

  @@index([vendorId])
  @@index([reviewerId])
}

model ProductReview {
  id         String       @id @default(cuid())
  reviewerId String
  productId  String
  orderId    String
  rating     Int
  title      String?
  comment    String?
  status     ReviewStatus @default(PUBLISHED)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  isVerified Boolean      @default(false)
  product    Product      @relation(fields: [productId], references: [id])
  reviewer   User         @relation(fields: [reviewerId], references: [id])

  @@index([productId])
  @@index([reviewerId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  data      Json?
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
}

model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique
  description String?
  isEnabled   Boolean  @default(false)
  allowList   Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SystemSetting {
  key       String   @id
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UploadIntent {
  id           String            @id @default(uuid())
  ownerType    MediaOwnerType
  ownerId      String
  resourceType MediaResourceType
  uploaderId   String
  status       MediaStatus       @default(PENDING)
  expiresAt    DateTime
  version      Int               @default(0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([uploaderId])
}

model Media {
  id               String                 @id @default(uuid())
  publicId         String                 @unique
  storageUrl       String
  provider         MediaProvider          @default(CLOUDINARY)
  providerAssetId  String?
  status           MediaStatus            @default(PENDING)
  ownerType        MediaOwnerType
  ownerId          String
  resourceType     MediaResourceType
  mimeType         String?
  format           String?
  bytes            Int?
  width            Int?
  height           Int?
  duration         Float?
  originalFilename String?
  version          String?
  etag             String?
  sha256           String?
  uploadedBy       String
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  deletedAt        DateTime?
  dbVersion        Int                    @default(0)
  animalPhoto      Animal?                @relation("AnimalPhoto")
  chatAttachment   ChatMessageAttachment? @relation("ChatMedia")
  userAvatar       User?                  @relation("UserAvatar")
  vendorAvatar     VendorProfile?         @relation("VendorAvatar")
  vetAvatar        VetProfile?            @relation("VetAvatar")
  vetLicense       VetProfile?            @relation("VetLicense")

  @@index([ownerType, ownerId])
  @@index([uploadedBy])
}

